    "expo": "~54",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "eas-cli": "^21.7.0"
  },
  "overrides": {
